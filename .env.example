# Local secrets template. Copy to .env, fill in, and never commit .env.
#
#   cp .env.example .env
#   source scripts/load-env.sh
#
# The bench reads these from the process environment. Keys are used by the
# provider on the host and are never passed into the sandbox, so the agent's
# tools cannot read them.

# Read-only Hugging Face token, for dataset and model downloads.
HF_TOKEN=

# Which provider the bench talks to:
#   fake          deterministic, no network, no key (the default)
#   openai        api.openai.com
#   openrouter    openrouter.ai, one key for many models
#   huggingface   router.huggingface.co
#   together      api.together.xyz
#   groq          api.groq.com
#   ollama        localhost:11434, no key
#   lmstudio      localhost:1234, no key
EVO_PROVIDER=fake

# Model id exactly as the provider spells it:
#   openai        gpt-5.5
#   openrouter    deepseek/deepseek-v4.1-flash-1017
#   huggingface   Qwen/Qwen3.5-72B-Instruct
#   ollama        qwen3:8b
EVO_MODEL=

# API key for the chosen provider. Leave empty for fake, ollama and lmstudio.
EVO_PROVIDER_KEY=

# Optional: override the endpoint, for a gateway or a self-hosted router.
# EVO_BASE_URL=https://openrouter.ai/api/v1

# Optional: app attribution, used by OpenRouter and some gateways.
# EVO_APP_NAME=evo-bench
# EVO_APP_URL=https://evo.aikitchen.cc
